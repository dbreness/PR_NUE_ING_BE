{
  "info": {
    "_postman_id": "a1c23ca5-f3e8-46cb-b9cc-79968914a6d4",
    "name": "Sistema de órdenes - Validación E2E",
    "description": "Ejecutar la colección completa y en orden con el stack iniciado. Usa exclusivamente datos ficticios, cifra la tarjeta antes del POST y valida creación, transición de estado, detalle, filtros, paginación y ordenamiento.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Crear orden principal cifrada",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const runId = `${Date.now()}-${Math.floor(Math.random() * 10000)}`;",
              "const productPrefix = `Producto Postman ${runId}`;",
              "pm.collectionVariables.set('productPrefix', productPrefix);",
              "pm.collectionVariables.set('productFilter', productPrefix.toLowerCase());",
              "",
              "const response = await pm.sendRequest(`${pm.collectionVariables.get('baseUrl')}/public-key.pem`);",
              "if (response.code !== 200) {",
              "  throw new Error('No fue posible obtener la clave pública');",
              "}",
              "",
              "const base64Key = response.text()",
              "  .replace('-----BEGIN PUBLIC KEY-----', '')",
              "  .replace('-----END PUBLIC KEY-----', '')",
              "  .replace(/\\s/g, '');",
              "const keyBytes = Uint8Array.from(atob(base64Key), (character) => character.charCodeAt(0));",
              "const publicKey = await crypto.subtle.importKey(",
              "  'spki',",
              "  keyBytes.buffer,",
              "  { name: 'RSA-OAEP', hash: 'SHA-256' },",
              "  false,",
              "  ['encrypt']",
              ");",
              "const cardData = new TextEncoder().encode(JSON.stringify({",
              "  cardNumber: '4111111111111111',",
              "  expiration: '12/30',",
              "  cvv: '123'",
              "}));",
              "const encrypted = await crypto.subtle.encrypt({ name: 'RSA-OAEP' }, publicKey, cardData);",
              "const encryptedBase64 = btoa(String.fromCharCode(...new Uint8Array(encrypted)));",
              "pm.collectionVariables.set('encryptedCardData', encryptedBase64);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 201 Created', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('La orden inicia PENDIENTE', () => pm.expect(body.status).to.eql('PENDIENTE'));",
              "pm.test('No expone encryptedCardData', () => pm.expect(body).not.to.have.property('encryptedCardData'));",
              "pm.collectionVariables.set('orderId', String(body.id));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productName\": \"{{productPrefix}} Alto\",\n  \"quantity\": 2,\n  \"amount\": 129.99,\n  \"encryptedCardData\": \"{{encryptedCardData}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/orders",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "orders"
          ]
        },
        "description": "Obtiene la clave pública, cifra datos ficticios con RSA-OAEP SHA-256 y crea la orden principal."
      }
    },
    {
      "name": "2. Crear orden secundaria cifrada",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 201 Created', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('La orden inicia PENDIENTE', () => pm.expect(body.status).to.eql('PENDIENTE'));",
              "pm.test('No expone encryptedCardData', () => pm.expect(body).not.to.have.property('encryptedCardData'));",
              "pm.collectionVariables.set('secondOrderId', String(body.id));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productName\": \"{{productPrefix}} Bajo\",\n  \"quantity\": 2,\n  \"amount\": 19.99,\n  \"encryptedCardData\": \"{{encryptedCardData}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/orders",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "orders"
          ]
        },
        "description": "Crea una segunda orden de menor monto para validar paginación y ordenamiento."
      }
    },
    {
      "name": "3. Esperar transición de la orden principal",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const terminalStatuses = ['PAGADO', 'FALLO_PAGO'];",
              "const maxAttempts = 30;",
              "const intervalMs = 1000;",
              "const detailUrl = `${pm.collectionVariables.get('baseUrl')}/api/orders/${pm.collectionVariables.get('orderId')}`;",
              "let response = pm.response;",
              "let body = {};",
              "",
              "for (let attempt = 1; attempt <= maxAttempts; attempt += 1) {",
              "  pm.test(`Consulta de estado ${attempt} responde 200`, () => pm.expect(response.code).to.eql(200));",
              "  if (response.code !== 200) {",
              "    break;",
              "  }",
              "",
              "  body = response.json();",
              "  if (terminalStatuses.includes(body.status)) {",
              "    break;",
              "  }",
              "  if (body.status !== 'PENDIENTE' || attempt === maxAttempts) {",
              "    break;",
              "  }",
              "",
              "  await new Promise((resolve) => setTimeout(resolve, intervalMs));",
              "  response = await pm.sendRequest(detailUrl);",
              "}",
              "",
              "pm.test('La orden alcanza un estado terminal', () => pm.expect(terminalStatuses).to.include(body.status));",
              "pm.test('El detalle no expone encryptedCardData', () => pm.expect(body).not.to.have.property('encryptedCardData'));",
              "if (terminalStatuses.includes(body.status)) {",
              "  pm.collectionVariables.set('finalStatus', body.status);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/orders/{{orderId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "orders",
            "{{orderId}}"
          ]
        },
        "description": "Consulta cada segundo hasta obtener PAGADO o FALLO_PAGO, con un máximo de 30 intentos."
      }
    },
    {
      "name": "4. Filtrar por producto",
      "event": [
