            {
              "key": "sort",
              "value": "createdAt,desc"
            }
          ]
        }
      }
    },
    {
      "name": "5. Filtrar por estado final",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "const orderId = Number(pm.collectionVariables.get('orderId'));",
              "const finalStatus = pm.collectionVariables.get('finalStatus');",
              "pm.test('Incluye la orden con el estado exacto', () => {",
              "  pm.expect(body.items.some((item) => item.id === orderId && item.status === finalStatus)).to.be.true;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/orders?status={{finalStatus}}&productName={{productPrefix}} Alto&page=0&size=10",
