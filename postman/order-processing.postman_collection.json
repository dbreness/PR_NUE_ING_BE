            "exec": [
              "pm.test('Responde 200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "const ids = body.items.map((item) => item.id);",
              "pm.test('El filtro parcial devuelve ambas órdenes', () => {",
              "  pm.expect(ids).to.include(Number(pm.collectionVariables.get('orderId')));",
              "  pm.expect(ids).to.include(Number(pm.collectionVariables.get('secondOrderId')));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/orders?productName={{productFilter}}&page=0&size=10&sort=createdAt,desc",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "orders"
          ],
          "query": [
            {
              "key": "productName",
              "value": "{{productFilter}}",
              "description": "Texto en minúsculas para comprobar búsqueda sin distinguir mayúsculas."
            },
            {
              "key": "page",
              "value": "0"
            },
            {
              "key": "size",
