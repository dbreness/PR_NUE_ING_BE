              "const body = pm.response.json();",
              "pm.test('Las órdenes están ordenadas por monto descendente', () => {",
              "  pm.expect(body.items).to.have.lengthOf(2);",
              "  pm.expect(body.items[0].id).to.eql(Number(pm.collectionVariables.get('orderId')));",
              "  pm.expect(body.items[1].id).to.eql(Number(pm.collectionVariables.get('secondOrderId')));",
              "  pm.expect(Number(body.items[0].amount)).to.be.greaterThan(Number(body.items[1].amount));",
